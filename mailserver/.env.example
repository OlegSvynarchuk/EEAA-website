# Copy to .env on the server and fill in real values. Never commit .env.
# Zoho Mail (EU region) - the mailbox that sends the form notifications.
SMTP_HOST=smtp.zoho.eu
SMTP_PORT=587
SMTP_USER=office@eeaa-alliance.com
SMTP_PASS=

# Must be the authenticated mailbox above, otherwise DMARC (p=quarantine) rejects it.
MAIL_FROM=office@eeaa-alliance.com

# Where form submissions are delivered.
MAIL_TO=office@eeaa-alliance.com
